# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Tooling scratch
.wrangler
.superpowers
.playwright-mcp
.remember
.claude/settings.local.json
test-results
playwright-report

# Test fixtures are rebuilt by scripts/build-fixture.mjs (see tests/fixtures/README.md)
tests/fixtures/*.iso
tests/fixtures/*.chd
tests/fixtures/*.bin
tests/fixtures/*.cue
tests/fixtures/*.zip

# Owner's own discs for local testing — never committed (spec §3)
games/
*.chd
*.pbp
*.cue
*.bin
*.iso
*.img
# Keep the fixture sources (psexe, licence, README) but never the built disc image.
!tests/fixtures/
!tests/fixtures/*.psexe
!tests/fixtures/*.txt
!tests/fixtures/*.md
tests/fixtures/*.iso

.dev.vars
