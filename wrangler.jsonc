// Used by the wrangler CLI (D1 migrations, local dev bindings via nitro-cloudflare-dev).
// Nitro merges this file into the generated deploy config (.output/server/wrangler.json).
{
  "name": "memcard",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "memcard", "database_id": "735471db-4c18-461a-a4ce-99e1681c8b86", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "memcard-libraries" }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SHARE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
